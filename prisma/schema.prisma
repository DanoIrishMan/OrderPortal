generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  STAFF
  CLIENT
}

enum StaffRole {
  ACCOUNT_MANAGER
  DESIGNER
}

enum OrderStatus {
  RECEIVED
  AWAITING_ARTWORK
  WITH_SUPPLIER
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum OrderSource {
  PDF_IMPORT
  CSV_IMPORT
  MANUAL
}

enum ImportType {
  PDF
  CSV
}

enum ImportStatus {
  PENDING
  COMMITTED
  FAILED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  name         String
  passwordHash String
  role         UserRole   @default(CLIENT)
  staffRole    StaffRole?
  clientId     String?
  client       Client?    @relation(fields: [clientId], references: [id], onDelete: SetNull)
  managedClients       Client[]          @relation("ClientAccountManager")
  pathwaysAsManager    CriticalPathway[] @relation("PathwayAccountManager")
  pathwaysAsDesigner   CriticalPathway[] @relation("PathwayDesigner")
  completedPathwayTasks PathwayTask[]    @relation("PathwayTaskCompletedBy")
  completedPathwaySubTasks PathwaySubTask[] @relation("PathwaySubTaskCompletedBy")
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

model Client {
  id              String          @id @default(cuid())
  name            String
  contactEmail    String
  active          Boolean         @default(true)
  accountManagerId String?
  accountManager  User?           @relation("ClientAccountManager", fields: [accountManagerId], references: [id], onDelete: SetNull)
  users           User[]
  orders          Order[]
  importBatches   ImportBatch[]
  csvMappings     CsvColumnMapping[]
  customerAliases CustomerAlias[]
  criticalPathways CriticalPathway[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([accountManagerId])
}

model CustomerAlias {
  id              String   @id @default(cuid())
  csvCustomerName String   @unique
  clientId        String
  client          Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([clientId])
}

model Order {
  id                    String      @id @default(cuid())
  clientId              String
  client                Client      @relation(fields: [clientId], references: [id], onDelete: Cascade)
  orderNumber           String
  section               String?
  orderDate             DateTime?
  poNumber              String?
  description           String?
  lineItems             String?
  quantity              Int?
  unitPrice             Float?
  totalPrice            Float?
  status                OrderStatus @default(RECEIVED)
  expectedDeliveryDate  DateTime?
  leavingOsFactoryDate  DateTime?
  actualDeliveryDate    DateTime?
  deliveredAt           DateTime?
  notes                 String?
  source                OrderSource @default(PDF_IMPORT)
  importBatchId         String?
  importBatch           ImportBatch? @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  events                OrderEvent[]
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@unique([clientId, orderNumber])
  @@index([clientId, status])
  @@index([clientId, updatedAt])
  @@index([clientId, deliveredAt])
}

model OrderEvent {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  field     String
  oldValue  String?
  newValue  String?
  source    OrderSource
  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
}

model ImportBatch {
  id           String       @id @default(cuid())
  clientId     String?
  client       Client?      @relation(fields: [clientId], references: [id], onDelete: SetNull)
  type         ImportType
  status       ImportStatus @default(PENDING)
  filename     String
  filePath     String
  rowCount     Int          @default(0)
  successCount Int          @default(0)
  errorCount   Int          @default(0)
  errors       String?
  metadata     String?
  orders       Order[]
  createdAt    DateTime     @default(now())
  committedAt  DateTime?

  @@index([clientId, createdAt])
}

model CsvColumnMapping {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String   @default("Default")
  mapping   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([clientId])
}

model ScheduledExport {
  id         String   @id @default(cuid())
  clientId   String
  dayOfWeek  Int      @default(1)
  hour       Int      @default(9)
  enabled    Boolean  @default(false)
  lastRunAt  DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([enabled, dayOfWeek])
}

model CriticalPathway {
  id               String        @id @default(cuid())
  clientId         String
  client           Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  accountManagerId String
  accountManager   User          @relation("PathwayAccountManager", fields: [accountManagerId], references: [id], onDelete: Restrict)
  designerId       String
  designer         User          @relation("PathwayDesigner", fields: [designerId], references: [id], onDelete: Restrict)
  name             String        @default("Critical Pathway")
  tasks            PathwayTask[]
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([clientId])
  @@index([accountManagerId])
  @@index([designerId])
}

model PathwayTask {
  id                  String          @id @default(cuid())
  pathwayId           String
  pathway             CriticalPathway @relation(fields: [pathwayId], references: [id], onDelete: Cascade)
  title               String
  dueDate             DateTime
  sortOrder           Int             @default(0)
  completedAt         DateTime?
  completedById       String?
  completedBy         User?           @relation("PathwayTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  assignAccountManager Boolean        @default(false)
  assignDesigner       Boolean        @default(false)
  reminderSent7DayAt  DateTime?
  reminderSent1DayAt  DateTime?
  overdueNotifiedAt   DateTime?
  subTasks            PathwaySubTask[]
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@index([pathwayId, sortOrder])
  @@index([dueDate])
}

model PathwaySubTask {
  id            String      @id @default(cuid())
  taskId        String
  task          PathwayTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  title         String
  sortOrder     Int         @default(0)
  completedAt   DateTime?
  completedById String?
  completedBy   User?       @relation("PathwaySubTaskCompletedBy", fields: [completedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@index([taskId, sortOrder])
}
